# Supabase project (use the service role key — this pipeline runs server-side
# and needs to bypass RLS to write knowledge_chunks)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only for per-item summary/tag generation in process-knowledge-intake.mjs
# (embeddings are generated locally via @xenova/transformers, no API key needed)
ANTHROPIC_API_KEY=your-anthropic-api-key
